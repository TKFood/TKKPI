    <GroupHeaderBand Name="GroupHeader1" Top="43.13" Width="1436.4" Height="18.9" Condition="[Table4.代號]" SortOrder="None">
      <TextObject Name="Text77" Left="756" Width="103.95" Height="18.9" Border.Lines="All" Text="銷售總金額POS機" HorzAlign="Center" VertAlign="Center"/>
      <TextObject Name="Text61" Width="94.5" Height="18.9" Border.Lines="All" Text="代號" HorzAlign="Center" VertAlign="Center"/>
