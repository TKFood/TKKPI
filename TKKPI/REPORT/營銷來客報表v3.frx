      <TableDataSource Name="Table1" DataType="System.Int32" Enabled="true" SelectCommand="SELECT &#13;&#10;[代號]&#13;&#10;,[門市]&#13;&#10;,[年度]&#13;&#10;,[月份]&#13;&#10;,[來客數]&#13;&#10;,[銷售總金額POS機]&#13;&#10;,[成交筆數]&#13;&#10;,[提袋率]&#13;&#10;,[平均客單價]&#13;&#10;,[實際的成交筆數]&#13;&#10;,[實際的銷售總金額POS機]&#13;&#10;,[實際的平均客單價]&#13;&#10;FROM [TKMK].[dbo].[Visitors_Monthly]&#13;&#10;WHERE [年度]='2026' AND [月份]='7'&#13;&#10;ORDER BY [代號]">
